# Copy to .env and fill in. Never commit .env
PROVIDER=gemini
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash   # use the model name shown in your AI Studio dashboard
# Optional backups if you hit Gemini's free limits:
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Seconds between API calls during evaluation (6 = about 10 calls/minute)
MIN_INTERVAL=6
